        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้ฝึกจินตนาการความรู้สึกของอีกฝ่าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giúp tập tưởng tượng cảm xúc của người khác."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to cvičení, jak si představit pocity druhého."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så øver man sig i at sætte sig i den andens sted."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι άσκηση στο να φανταζόμαστε πώς νιώθει ο άλλος."
