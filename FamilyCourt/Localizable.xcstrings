    "형사 소송은 어긴 법을 꼭 골라야 해요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A criminal case needs a broken rule chosen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A criminal case needs a broken rule chosen"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刑事裁判では、やぶられた法律をかならず選んでください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刑事诉讼必须选择违反的家规"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刑事訴訟一定要選擇違反的家規"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для уголовного дела нужно выбрать нарушенное правило"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un caso penal hay que elegir la ley incumplida"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer Strafsache musst du die gebrochene Regel auswählen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un procès pénal, il faut choisir la loi enfreinte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una causa penale bisogna scegliere la legge violata"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em caso criminal, é preciso escolher a lei desrespeitada"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คดีอาญาต้องเลือกกฎที่ถูกฝ่าฝืนก่อนนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vụ hình sự phải chọn luật bị vi phạm"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U trestního případu je potřeba vybrat porušené pravidlo"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en straffesag skal du vælge den regel, der er brudt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε ποινική υπόθεση πρέπει να διαλέξεις τον νόμο που παραβιάστηκε"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikosasiassa pitää valita, mitä sääntöä rikottiin"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkara pidana wajib memilih hukum yang dilanggar"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en straffesak må du velge hvilken regel som ble brutt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij een strafzaak moet je de overtreden regel kiezen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sprawie karnej trzeba wybrać złamane prawo"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ett brottmål måste du välja vilken regel som bröts"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceza davası için çiğnenen kanunu mutlaka seçmelisin"
          }
        }
      }
    },
