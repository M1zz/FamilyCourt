    "재판을 열려면 가족이 3명 이상 필요해요 (판사도 필요해요!). [가족] 탭에서 먼저 등록해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trial needs at least 3 family members (you need a judge too!). Add them in the [Family] tab first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trial needs at least 3 family members (you need a judge too!). Add them in the [Family] tab first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判を開くには家族が3人以上必要です（裁判官も必要です！）。先に［家族］タブで登録してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开庭需要至少3位家人（还需要法官！）。请先在[家人]标签里登记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開庭需要至少3位家人（還需要法官！）。請先在[家人]分頁登記。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для суда нужно минимум 3 члена семьи (судья тоже нужен!). Сначала добавь их во вкладке [Семья]."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un juicio hacen falta al menos 3 familiares (¡también un juez!). Regístralos primero en la pestaña [Familia]."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine Verhandlung braucht ihr mindestens 3 Personen (auch einen Richter!). Tragt sie zuerst im Tab [Familie] ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut au moins 3 membres de la famille pour un procès (dont un juge !). Inscris-les d’abord dans l’onglet [Famille]."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un processo servono almeno 3 familiari (compreso il giudice!). Registrali prima nella scheda [Famiglia]."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir um julgamento, é preciso ter pelo menos 3 pessoas (inclusive o juiz!). Cadastre a família primeiro na aba [Família]."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องมีสมาชิกอย่างน้อย 3 คนถึงจะเปิดศาลได้ (ต้องมีผู้พิพากษาด้วย!) ลงทะเบียนในแท็บ [ครอบครัว] ก่อนนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần ít nhất 3 thành viên để mở phiên tòa (còn cần cả thẩm phán nữa!). Hãy thêm thành viên ở tab [Gia đình] trước nhé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
