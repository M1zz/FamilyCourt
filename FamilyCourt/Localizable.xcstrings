        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bon exercice pour imaginer ce que ressent l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esercizio per immaginare cosa prova l’altro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um treino para imaginar o que o outro sente."
          }
