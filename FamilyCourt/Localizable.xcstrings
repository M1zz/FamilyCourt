          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juicio para resolver algo injusto y recibir una disculpa o una compensación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier wird etwas Ungerechtes geklärt, und es gibt eine Entschuldigung oder Wiedergutmachung."
          }
        },
        "fr" : {
