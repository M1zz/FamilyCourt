    "억울한 일을 해결하고 사과나 보상을 받는 재판이에요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trial to sort out something unfair and get an apology or a make-up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trial to sort out something unfair and get an apology or a make-up."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "くやしい思いを解決して、あやまってもらったり、つぐなってもらったりする裁判です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解决委屈的事，得到道歉或补偿的审判。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解決委屈的事，得到道歉或補償的審判。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
