    "법 위반을 목격한 사람이 검사가 되어 공소를 제기합니다. 피고인과 재판장은 검사가 지정합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A witness to the violation acts as prosecutor and files the charges. The prosecutor designates the defendant and the presiding judge."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A witness to the violation acts as prosecutor and files the charges. The prosecutor designates the defendant and the presiding judge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法律違反を目撃した者が検察官として公訴を提起します。被告人と裁判長は検察官が指定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目睹违反家规行为的人以检察官身份提起公诉。被告人和审判长由检察官指定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目睹違反家規行為的人以檢察官身分提起公訴。被告與審判長由檢察官指定。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очевидец нарушения выступает прокурором и возбуждает обвинение. Подсудимого и председательствующего назначает прокурор."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien presencia una infracción actúa como fiscal y ejerce la acción penal. El fiscal designa al acusado y al presidente del tribunal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer einen Regelverstoß beobachtet hat, erhebt als Staatsanwalt Anklage. Angeklagten und Vorsitzenden Richter bestimmt die Staatsanwaltschaft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le témoin d’une infraction devient procureur et engage l’action publique. Le procureur désigne l’accusé et le président du tribunal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi assiste a una violazione diventa pubblico ministero ed esercita l’azione penale. Il PM designa l’imputato e il presidente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem presenciou a infração atua como promotor e oferece a denúncia. O acusado e o juiz presidente são designados pelo promotor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้พบเห็นการฝ่าฝืนกฎเป็นอัยการและยื่นฟ้องคดีอาญา โดยอัยการเป็นผู้กำหนดจำเลยและผู้พิพากษาหัวหน้าคณะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người chứng kiến hành vi vi phạm làm công tố viên và khởi tố. Bị cáo và chủ tọa do công tố viên chỉ định."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svědek porušení pravidla podává jako státní zástupce obžalobu. Obžalovaného a předsedu senátu určuje státní zástupce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der har overværet et regelbrud, rejser tiltale som anklager. Anklageren udpeger tiltalte og retsformand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος υπήρξε μάρτυρας της παράβασης ασκεί δίωξη ως εισαγγελέας. Τον κατηγορούμενο και τον Πρόεδρο του Δικαστηρίου τους ορίζει ο εισαγγελέας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säännön rikkomisen havainnut ryhtyy syyttäjäksi ja nostaa syytteen. Syyttäjä nimeää syytetyn ja puheenjohtajan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pihak yang menyaksikan pelanggaran hukum menjadi jaksa dan melimpahkan dakwaan. Terdakwa dan Hakim Ketua ditunjuk oleh jaksa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har vært vitne til regelbruddet, blir aktor og tar ut tiltale. Aktor utpeker tiltalte og rettens leder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie een overtreding heeft gezien, stelt als aanklager vervolging in. De aanklager wijst de verdachte en de voorzitter aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świadek naruszenia prawa jako prokurator wnosi akt oskarżenia. Oskarżonego i przewodniczącego wyznacza prokurator."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har bevittnat regelbrottet blir åklagare och väcker åtal. Åklagaren utser den tilltalade och rättens ordförande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanun ihlaline tanık olan kişi savcı sıfatıyla kamu davası açar. Sanığı ve mahkeme başkanını savcı belirler."
          }
        }
      }
    },
