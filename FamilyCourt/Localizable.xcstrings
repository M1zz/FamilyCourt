        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@宣读%@做错了什么：\n\n“%@%@按以下方式违反了我们家的家规。”\n\n📄 案件内容：%@\n📜 违反的家规：%@"
