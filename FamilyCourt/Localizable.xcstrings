        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rettssak der noe urettferdig blir løst, og man får en unnskyldning eller noe tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier wordt iets oneerlijks opgelost, met een sorry of iets om het goed te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rozwiązujemy krzywdy: winny przeprasza albo naprawia szkodę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
