    "한 번 한 약속은 지킨다. 지키기 어려울 때는 미리 말한다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the promises you make. If one is hard to keep, say so ahead of time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the promises you make. If one is hard to keep, say so ahead of time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度した約束は守る。守れそうにないときは、前もって言う。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说好的事就要做到。做不到的时候，要提前说。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說好的事就要做到。做不到的時候，要先說。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данное обещание выполняем. Если выполнить трудно, говорим об этом заранее."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las promesas se cumplen. Si cuesta cumplirlas, se avisa antes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versprochen ist versprochen. Wenn es schwierig wird, sagen wir es vorher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une promesse, on la tient. Si c’est difficile, on le dit à l’avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le promesse si mantengono. Se è difficile, lo si dice prima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promessa feita é promessa cumprida. Se ficar difícil cumprir, avise antes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัญญาแล้วต้องทำตาม ถ้าทำไม่ได้ให้บอกล่วงหน้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã hứa thì phải giữ. Khi khó giữ thì nói trước."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co slíbíme, to dodržíme. Když to bude těžké, řekneme to předem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et løfte er et løfte. Hvis det bliver svært, siger vi det i forvejen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια υπόσχεση την κρατάμε. Αν δυσκολευόμαστε, το λέμε από πριν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupaus pidetään. Jos sen pitäminen on vaikeaa, siitä kerrotaan etukäteen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janji yang sudah dibuat harus ditepati. Kalau sulit, bilang lebih dulu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et løfte skal holdes. Hvis det blir vanskelig, sier vi ifra på forhånd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een afspraak is een afspraak. Lukt het niet, dan zeg je het van tevoren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotrzymujemy obietnic. Jeśli coś będzie trudne, mówimy o tym wcześniej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett löfte ska hållas. Om det blir svårt säger vi till i förväg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verilen söz tutulur. Tutmak zor olacaksa önceden söylenir."
          }
        }
      }
    },
