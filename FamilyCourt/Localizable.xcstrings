          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un processo per risolvere un torto e ricevere scuse o un rimedio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Julgamento para resolver uma injustiça e receber desculpas ou uma compensação."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นการพิจารณาคดีเพื่อแก้เรื่องที่ไม่ยุติธรรม และได้คำขอโทษหรือการชดเชย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên tòa giải quyết chuyện oan ức, để nhận lời xin lỗi hoặc đền bù."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tady se řeší křivdy: viník se omluví nebo škodu napraví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her bliver noget uretfærdigt løst, og man får en undskyldning eller noget, der gør det godt igen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι η δίκη που λύνει μια αδικία και φέρνει συγγνώμη ή αποζημίωση."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oikeudenkäynti, jossa epäreilu asia ratkaistaan ja saadaan anteeksipyyntö tai hyvitys."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
