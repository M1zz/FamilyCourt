    "앱의 모든 기록(가족, 법전, 소송, 판결)을 파일로 저장해두거나 다시 불러올 수 있어요. 기기를 바꿀 때 사용하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all of the app's records (family, law book, cases, verdicts) to a file, or load them back in. Handy when you switch devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all of the app's records (family, law book, cases, verdicts) to a file, or load them back in. Handy when you switch devices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのすべての記録（家族、法律書、裁判、判決）をファイルに保存したり、読み込んだりできます。機種変更のときに使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把应用里的所有记录（家人、法典、诉讼、判决）保存成文件，也可以重新导入。换设备时请使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把 App 裡的所有紀錄（家人、法典、訴訟、判決）儲存成檔案，也可以重新匯入。換手機時請使用。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записи (семью, кодекс, дела и приговоры) можно сохранить в файл и потом загрузить обратно. Пригодится при смене устройства."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes guardar en un archivo todos los datos de la app (familia, leyes, casos, sentencias) y volver a cargarlos. Útil al cambiar de dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst alle Daten der App (Familie, Gesetzbuch, Fälle, Urteile) in einer Datei sichern und später wieder laden. Praktisch, wenn du ein neues Gerät bekommst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux enregistrer toutes les données de l’app (famille, code, procès, verdicts) dans un fichier et les recharger. Pratique pour changer d’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi salvare in un file tutti i dati dell’app (famiglia, codice, cause, sentenze) e ricaricarli. Utile quando cambi dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve todos os registros do app (família, leis, casos e sentenças) num arquivo ou carregue tudo de novo. Útil ao trocar de aparelho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกข้อมูลทั้งหมดในแอป (ครอบครัว กฎบ้าน คดี คำตัดสิน) เป็นไฟล์ หรือโหลดกลับมาได้ ใช้ตอนเปลี่ยนเครื่อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể lưu toàn bộ hồ sơ của ứng dụng (gia đình, bộ luật, vụ kiện, bản án) thành tệp hoặc tải lại. Dùng khi đổi máy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny záznamy (rodinu, zákoník, případy a rozsudky) můžeš uložit do souboru a později je zase načíst. Hodí se při výměně zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan gemme alle appens data (familie, lovbog, sager, domme) i en fil og hente dem igen senere. Smart, når du får en ny enhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε όλα τα δεδομένα της εφαρμογής (οικογένεια, Κώδικας, υποθέσεις, αποφάσεις) σε ένα αρχείο ή φορτώστε τα ξανά. Χρήσιμο όταν αλλάζετε συσκευή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna kaikki sovelluksen tiedot (perhe, lakikirja, asiat ja tuomiot) tiedostoon tai tuo ne takaisin. Kätevä, kun vaihdat laitetta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua catatan aplikasi (keluarga, kitab hukum, perkara, putusan) bisa disimpan ke file atau dimuat kembali. Gunakan saat ganti perangkat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre alt i appen (familie, lovbok, saker og dommer) som en fil, eller hent det inn igjen. Nyttig når du bytter enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt alle gegevens van de app (gezin, wetboek, zaken, vonnissen) in een bestand bewaren en later weer laden. Handig als je een nieuw apparaat krijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zapisy (rodzinę, kodeks, sprawy i wyroki) możesz zapisać w pliku i później wczytać. Przydaje się przy zmianie urządzenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara allt i appen (familj, lagbok, mål och domar) som en fil, eller läs in det igen. Bra när du byter enhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadaki tüm kayıtları (aile, kanunlar, davalar, kararlar) bir dosyaya kaydedebilir ya da geri yükleyebilirsiniz. Cihaz değiştirirken kullanın."
          }
        }
      }
    },
