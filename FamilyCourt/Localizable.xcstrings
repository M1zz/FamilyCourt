    "가족은 서로에게 나쁜 말이나 상처 주는 말을 하지 않는다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family members never say mean or hurtful things to each other."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family members never say mean or hurtful things to each other."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族はおたがいに、いやなことや傷つくことを言わない。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人之间不说难听的话，也不说伤人的话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人之間不說難聽的話，也不說傷人的話。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В семье не говорят друг другу плохих и обидных слов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la familia no nos decimos cosas feas ni que hagan daño."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen in der Familie keine gemeinen oder verletzenden Wörter zueinander."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En famille, on ne se dit pas de méchancetés ni de mots qui font mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In famiglia non ci diciamo parole cattive o che fanno male."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na família, ninguém fala palavras feias ou que machucam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนในครอบครัวไม่พูดจาไม่ดีหรือทำร้ายจิตใจกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả nhà không nói lời xấu hay lời làm tổn thương nhau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V rodině si neříkáme ošklivá ani zraňující slova."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I familien siger vi ikke grimme eller sårende ting til hinanden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην οικογένεια δεν λέμε άσχημα ή πληγωτικά λόγια ο ένας στον άλλον."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perheessämme ei sanota toisille ilkeitä tai loukkaavia asioita."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anggota keluarga tidak saling berkata kasar atau menyakitkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I familien vår sier vi ikke stygge eller sårende ting til hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
