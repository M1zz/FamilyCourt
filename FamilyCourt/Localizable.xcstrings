    "기본 법원 용어에 쉬운 설명을 곁들여요.\n예) 원고 승소 (원고 말이 맞아요)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real court words with a simple explanation.\ne.g. Plaintiff Wins (the Plaintiff is right)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real court words with a simple explanation.\ne.g. Plaintiff Wins (the Plaintiff is right)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本物の裁判のことばに、やさしい説明をそえます。\n例）原告勝訴（原告の言うとおり）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用基本的法庭用语，并附上简单解释。\n例）原告胜诉（原告说得对）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用基本的法庭用語，並加上簡單的說明。\n例）原告勝訴（原告說得對）"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настоящие судебные слова с простыми пояснениями.\nНапример: победа истца (истец прав)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras de verdad del tribunal, con una explicación sencilla.\nEj.: Gana el demandante (el demandante tiene razón)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echte Gerichtswörter mit einfacher Erklärung.\nz. B. Kläger gewinnt (Der Kläger hat recht)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vrais mots du tribunal, avec une explication simple.\nEx. : Demandeur gagne (le demandeur a raison)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parole vere del tribunale, con una spiegazione semplice.\nEs.: Vince l’attore (l’attore ha ragione)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termos de tribunal com uma explicação simples.\nEx.: Autor vence (o autor tem razão)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ศัพท์ศาลพื้นฐานพร้อมคำอธิบายง่าย ๆ\nเช่น โจทก์ชนะคดี (โจทก์พูดถูก)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ ngữ tòa án cơ bản kèm giải thích dễ hiểu.\nVD: Nguyên đơn thắng kiện (Nguyên đơn nói đúng)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skutečná soudní slova s jednoduchým vysvětlením.\nNapř.: žalobce vyhrál (žalobce má pravdu)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rigtige ord fra retten med en nem forklaring.\nF.eks. Sagsøger vinder (sagsøger har ret)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πραγματικοί δικαστικοί όροι με μια απλή εξήγηση.\nπ.χ. Δικαίωση ενάγοντος (ο ενάγων έχει δίκιο)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oikeita oikeussanoja helpon selityksen kera.\nEsim. Kantaja voittaa (Kantaja on oikeassa)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istilah pengadilan dasar dengan penjelasan mudah.\nContoh) Penggugat menang (kata Penggugat benar)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekte rettsord med en enkel forklaring.\nF.eks. Saksøkeren vinner (Saksøkeren har rett)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echte rechtbankwoorden met een makkelijke uitleg.\nBijv. Eiser wint (de eiser heeft gelijk)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawdziwe słowa sądowe z prostym wyjaśnieniem.\nNp.: wygrana powoda (powód ma rację)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riktiga rättsord med en enkel förklaring.\nT.ex. Käranden vinner (Käranden har rätt)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek mahkeme kelimeleri, yanında kolay açıklamalarla.\nÖrn. Davacı kazandı (davacı haklı)"
          }
        }
      }
    },
