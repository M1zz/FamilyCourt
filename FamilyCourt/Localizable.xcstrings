          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が話します：\n\n・いつ、どこで、何がありましたか？\n・どんな気持ちになりましたか？\n・どうしてほしいですか？ %@\n\n⭐ ルール：大きな声を出さない、本当のことだけ話す！"
