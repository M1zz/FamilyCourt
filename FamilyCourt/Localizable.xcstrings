    "답장이 필요한 문의는 메일로, 가벼운 이야기는 인스타그램 DM으로 보내 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For questions that need a reply, send an email. For a quick chat, send an Instagram DM."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For questions that need a reply, send an email. For a quick chat, send an Instagram DM."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信が必要なお問い合わせはメールで、気軽なお話はInstagramのDMで送ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要回复的问题请发邮件，随便聊聊可以发 Instagram 私信。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要回覆的問題請寄電子郵件，輕鬆聊聊可以傳 Instagram 私訊。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если нужен ответ, пиши на почту, а если просто хочешь поболтать — в директ Instagram."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si necesitas respuesta, escribe un correo; para charlar, manda un mensaje directo por Instagram."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Antwort brauchst, schreib eine E-Mail. Für kurze Nachrichten passt eine Instagram-DM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour avoir une réponse, écris par e-mail ; pour un petit mot, envoie un message privé sur Instagram."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per avere una risposta scrivi un’e-mail; per due chiacchiere manda un DM su Instagram."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para dúvidas que precisam de resposta, mande um e-mail. Para um papo rápido, mande uma DM no Instagram."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าต้องการคำตอบ ส่งอีเมลมาได้ ถ้าแค่อยากคุยเล่น ส่ง DM ทางอินสตาแกรมได้เลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu hỏi cần trả lời hãy gửi qua email, chuyện nhỏ thì nhắn qua Instagram DM nhé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když potřebuješ odpověď, napiš e-mail. Na drobnosti stačí zpráva na Instagramu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en mail, hvis du har brug for svar. Til en kort besked kan du sende en Instagram-DM."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ερωτήσεις που θέλουν απάντηση στείλτε email· για μια απλή κουβέντα, DM στο Instagram."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä vastausta vaativat kysymykset sähköpostilla ja kevyemmät jutut Instagramin yksityisviestinä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
