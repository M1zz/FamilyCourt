    "다음에 화가 나면 어떻게 할지 계획 세워서 가족 앞에서 발표하기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a plan for what to do next time you get angry, and share it with the family"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a plan for what to do next time you get angry, and share it with the family"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に怒ったときどうするか計画を立てて、家族の前で発表する"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
