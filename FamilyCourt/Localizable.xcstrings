    "실제 법원에서 쓰는 용어 그대로 보여줘요.\n예) 재판장, 최후 진술, 구형, 공소사실 낭독" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exact terms used in a real courtroom.\ne.g. Presiding Judge, Closing Statement, Sentencing Request, Reading of the Charges"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exact terms used in a real courtroom.\ne.g. Presiding Judge, Closing Statement, Sentencing Request, Reading of the Charges"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本物の裁判所で使うことばをそのまま表示します。\n例）裁判長、最終陳述、求刑、起訴状朗読"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接使用真正法院里的用语。\n例）审判长、最后陈述、量刑建议、宣读起诉书"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接使用真正法院裡的用語。\n例）審判長、最後陳述、求刑、朗讀起訴書"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термины, как в настоящем суде.\nНапример: председательствующий, последнее слово, запрос наказания, оглашение обвинения"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los términos que se usan de verdad en un tribunal.\nEj.: Presidente, Última palabra, Petición de pena, Lectura del escrito de acusación"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Begriffe wie in einem echten Gericht.\nz. B. Vorsitzender Richter, Schlusswort, Strafantrag, Verlesung der Anklage"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vrais termes utilisés au tribunal.\nEx. : Président, Dernière déclaration, Réquisitions, Lecture de l’acte d’accusation"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I termini usati davvero in tribunale.\nEs.: Presidente, Ultime dichiarazioni, Richiesta di pena, Lettura del capo d’imputazione"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os termos usados num tribunal de verdade.\nEx.: Juiz presidente, Declaração final, Pedido de pena, Leitura da denúncia"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ศัพท์ที่ใช้ในศาลจริง\nเช่น ผู้พิพากษาหัวหน้าคณะ, คำแถลงปิดคดี, คำขอลงโทษ, การอ่านคำฟ้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng đúng từ ngữ của tòa án thật.\nVD: Chủ tọa, Lời nói sau cùng, Đề nghị mức án, Công bố cáo trạng"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slova jako u skutečného soudu.\nNapř.: předseda senátu, poslední slovo, návrh trestu, přednesení obžaloby"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene, som de bruges i en rigtig retssal.\nF.eks. retsformand, sidste ord, strafpåstand, oplæsning af anklageskriftet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι όροι όπως ακριβώς λέγονται σε πραγματικό δικαστήριο.\nπ.χ. Πρόεδρος Δικαστηρίου, απολογία, πρόταση ποινής, ανάγνωση κατηγορητηρίου"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juuri ne sanat, joita oikeassa tuomioistuimessa käytetään.\nEsim. Puheenjohtaja, loppulausunto, rangaistusvaatimus, syytteen lukeminen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan dengan istilah yang dipakai di pengadilan sungguhan.\nContoh) Hakim Ketua, pembelaan terakhir, tuntutan, pembacaan surat dakwaan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkurat de ordene som brukes i en ekte domstol.\nF.eks. Rettens leder, siste ord, påstand om straff, opplesning av tiltalen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De woorden zoals in een echte rechtbank.\nBijv. voorzitter, laatste woord, eis, voorlezing van de tenlastelegging"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowa jak w prawdziwym sądzie.\nNp.: przewodniczący, ostatnie słowo, wniosek o karę, odczytanie aktu oskarżenia"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precis de ord som används i en riktig domstol.\nT.ex. Rättens ordförande, slutanförande, påföljdsyrkande, gärningsbeskrivning"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek mahkemede kullanılan terimler.\nÖrn. Mahkeme Başkanı, Son söz, Ceza talebi, İddianamenin okunması"
          }
        }
      }
    },
