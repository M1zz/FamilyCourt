    "재판에 불려 나온 사람 편에서 도와줘요. 지켜 주는 좋은 이유를 찾아 줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stands by the person called to the trial and finds good reasons to defend them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stands by the person called to the trial and finds good reasons to defend them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判に呼ばれた人の味方になって助けます。かばってあげられるよい理由を見つけます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在被叫上法庭的人这边帮忙，替他找出好的理由。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在被叫上法庭的人這邊幫忙，替他找出好的理由。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогает тому, кого вызвали в суд. Ищет добрые причины, чтобы его защитить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a quien ha sido llamado a juicio. Busca buenas razones para defenderle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft der Person, die vor Gericht gerufen wurde, und sucht gute Gründe, die für sie sprechen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide la personne appelée au procès. Trouve de bonnes raisons de la défendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta chi è stato chiamato al processo. Trova buoni motivi per difenderlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica do lado de quem foi chamado a julgamento e procura bons motivos para defendê-lo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยู่ข้างคนที่ถูกเรียกขึ้นศาล และช่วยหาเหตุผลดี ๆ มาปกป้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đứng về phía người được gọi ra tòa để giúp đỡ. Tìm những lý do tốt để bảo vệ bạn ấy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomáhá tomu, kdo byl předvolán k soudu. Hledá dobré důvody, jak ho obhájit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælper den, der er kaldt for retten, og finder gode grunde, der taler for vedkommende."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέκεται στο πλευρό αυτού που κλήθηκε στη δίκη. Βρίσκει καλούς λόγους να τον υπερασπιστεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auttaa oikeuteen kutsuttua ja etsii hyviä syitä hänen puolestaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membantu dari pihak orang yang dipanggil ke sidang. Mencarikan alasan baik untuk membelanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjelper den som er innkalt til rettssaken, og leter etter gode grunner som taler for hen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staat naast wie voor de rechter is geroepen en zoekt goede redenen die voor diegene pleiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaga osobie wezwanej przed sąd. Szuka dobrych powodów, by ją obronić."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjälper den som har kallats till rättegången och letar efter goda skäl som talar för hen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duruşmaya çağrılan kişinin yanında olur, ona yardım eder. Onu savunmak için iyi nedenler bulur."
          }
        }
      }
    },
    "재판에 불려 나온 사람이에요. 자기 생각을 이야기할 권리가 있고, %@ 고를 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person called to the trial. They have the right to tell their side, and can choose a %@."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person called to the trial. They have the right to tell their side, and can choose a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判に呼ばれた人です。自分の考えを話す権利があり、%@を選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被叫上法庭的人。有权说出自己的想法，还可以选一位%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被叫上法庭的人。有權說出自己的想法，還可以選一位%@。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот, кого вызвали в суд. Он может рассказать, что думает, и выбрать, кто будет его защищать (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es quien ha sido llamado a juicio. Tiene derecho a contar lo que piensa y puede elegir a alguien que le ayude (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde vor Gericht gerufen. Darf die eigene Sicht erzählen und sich Unterstützung aussuchen (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la personne appelée au procès. Elle a le droit de donner son avis et peut choisir quelqu’un pour l’aider (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È chi viene chiamato al processo. Ha il diritto di dire come la pensa e può scegliere qualcuno che lo aiuti (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem foi chamado a julgamento. Tem o direito de dar sua opinião e pode escolher alguém para ser %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ถูกเรียกขึ้นศาล มีสิทธิ์เล่าความคิดของตัวเอง และเลือก%@ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người được gọi ra tòa. Có quyền nói suy nghĩ của mình và có thể chọn %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten, kdo byl předvolán k soudu. Má právo říct, co si myslí, a může si vybrat, kdo ho bude hájit (%@)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kaldt for retten. Har ret til at fortælle sin side og kan vælge en, der hjælper (%@)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλήθηκε στη δίκη. Έχει το δικαίωμα να πει τη γνώμη του και να διαλέξει βοηθό (%@)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, joka on kutsuttu oikeuteen. Saa kertoa oman mielipiteensä ja voi valita auttajan (%@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang dipanggil ke sidang. Ia berhak menyampaikan pendapatnya dan boleh memilih %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som er innkalt til rettssaken. Har rett til å si hva hen mener, og kan velge en hjelper (%@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is voor de rechter geroepen. Mag het eigen verhaal vertellen en iemand kiezen die helpt (%@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba wezwana przed sąd. Ma prawo powiedzieć, co myśli, i może wybrać, kto będzie jej bronił (%@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har kallats till rättegången. Har rätt att säga vad hen tycker och får välja en hjälpare (%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duruşmaya çağrılan kişidir. Kendi düşüncesini anlatma hakkı vardır ve bir yardımcı seçebilir (%@)."
          }
        }
      }
    },
    "재판에 참여할 가족을 모두 등록해 주세요. 누구든 사건에 따라 원고도, 검사도, 판사도 될 수 있어요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add everyone who'll take part in trials. Depending on the case, anyone can be the plaintiff, the prosecutor or the judge!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add everyone who'll take part in trials. Depending on the case, anyone can be the plaintiff, the prosecutor or the judge!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判に参加する家族をみんな登録してください。事件によって、だれでも原告にも、検察官にも、裁判官にもなれます！"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请把参加审判的家人都登记上。根据案件不同，每个人都可以当原告、检察官，也可以当法官！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請把參加審判的家人都登記進來。依照案件不同，每個人都可以當原告、檢察官，也可以當法官！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь всех, кто будет участвовать в суде. В разных делах каждый может быть истцом, прокурором или судьёй!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra a todos los familiares que participan en los juicios. Según el caso, cualquiera puede ser demandante, fiscal o juez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag alle ein, die bei den Verhandlungen mitmachen. Je nach Fall kann jede und jeder Kläger, Staatsanwalt oder Richter sein!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inscris tous les membres de la famille qui participent aux procès. Selon l’affaire, chacun peut être demandeur, procureur ou juge !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tutti i familiari che partecipano ai processi. A seconda del caso, chiunque può essere attore, pubblico ministero o giudice!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadastre todos da família que vão participar. Dependendo do caso, qualquer um pode ser autor, promotor ou juiz!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงทะเบียนสมาชิกทุกคนที่จะร่วมพิจารณาคดี ทุกคนเป็นได้ทั้งโจทก์ อัยการ หรือผู้พิพากษา แล้วแต่คดี!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thêm tất cả thành viên sẽ tham gia phiên tòa. Tùy từng vụ, ai cũng có thể là nguyên đơn, công tố viên hay thẩm phán!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej všechny, kdo se budou účastnit soudu. Podle případu může být každý žalobcem, státním zástupcem i soudcem!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj alle, der skal være med i retssagerne. Alt efter sagen kan alle være sagsøger, anklager eller dommer!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταχωρίστε όλα τα μέλη που θα παίρνουν μέρος στις δίκες. Ανάλογα με την υπόθεση, ο καθένας μπορεί να γίνει ενάγων, εισαγγελέας ή δικαστής!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kaikki perheenjäsenet, jotka osallistuvat oikeudenkäynteihin. Kuka tahansa voi olla asiasta riippuen kantaja, syyttäjä tai tuomari!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftarkan semua anggota keluarga yang ikut sidang. Siapa saja bisa jadi penggugat, jaksa, atau hakim, tergantung perkaranya!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til alle i familien som skal være med i rettssakene. Hvem som helst kan være saksøker, aktor eller dommer, alt etter saken!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg iedereen toe die meedoet aan de zittingen. Afhankelijk van de zaak kan iedereen eiser, aanklager of rechter zijn!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj wszystkich, którzy będą brać udział w procesach. W zależności od sprawy każdy może być powodem, prokuratorem albo sędzią!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till alla i familjen som ska vara med i rättegångarna. Vem som helst kan vara kärande, åklagare eller domare, beroende på målet!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duruşmalara katılacak tüm aileyi kaydedin. Davaya göre herkes davacı da, savcı da, hakim de olabilir!"
          }
        }
      }
    },
    "재판에서 나온 이야기를 기록하는 사람이에요. 없어도 재판은 열 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes down what's said in the trial. The trial can still go ahead without one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes down what's said in the trial. The trial can still go ahead without one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判で出た話を記録する人です。いなくても裁判は開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把审判中说的话记下来的人。没有也可以开庭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把審判中說的話記下來的人。沒有也可以開庭。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает всё, что говорят на суде. Суд можно провести и без него."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta lo que se dice en el juicio. Se puede hacer el juicio sin este papel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt auf, was in der Verhandlung gesagt wird. Es geht aber auch ohne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note ce qui se dit pendant le procès. On peut faire le procès sans ce rôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive quello che si dice durante il processo. Il processo si può fare anche senza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota tudo o que é dito no julgamento. Não é obrigatório: o julgamento acontece mesmo sem ele."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่จดบันทึกสิ่งที่พูดกันในศาล ไม่มีก็เปิดศาลได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người ghi lại những gì được nói trong phiên tòa. Không có cũng vẫn xử được."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje, co u soudu zazní. Soud se může konat i bez něj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ned, hvad der bliver sagt i retsmødet. Det kan også klares uden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράφει όσα λέγονται στη δίκη. Η δίκη γίνεται και χωρίς αυτόν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoittaa muistiin, mitä oikeudenkäynnissä sanotaan. Oikeudenkäynnin voi pitää ilmankin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang mencatat apa yang dibicarakan di sidang. Tanpa dia pun sidang tetap bisa dibuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ned det som blir sagt i rettssaken. Trengs ikke for at rettssaken skal kunne holdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft op wat er in de zitting wordt gezegd. Het kan ook zonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje wszystko, co pada na rozprawie. Proces może się odbyć także bez niego."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ner det som sägs i rättegången. Behövs inte för att rättegången ska kunna hållas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duruşmada konuşulanları not eden kişidir. Olmasa da duruşma yapılabilir."
          }
        }
      }
    },
