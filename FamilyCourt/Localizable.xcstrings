        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình bày ra thì mình tự dọn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo udělá nepořádek, ten ho uklidí."
          }
        },
        "da" : {
          "stringUnit" : {
