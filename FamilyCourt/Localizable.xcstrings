            "state" : "translated",
            "value" : "自分でちらかしたものは、自分で片づける。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己弄乱的东西，自己收拾好。"
