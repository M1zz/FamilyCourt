    "%@ 큰 소리로 말해요:\n\n\"지금부터 %@ %@ 재판을 시작하겠습니다.\n사건번호 %@, 「%@」 사건입니다.\n모두 바르게 앉아 주세요!\"" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ says out loud:\n\n“%@ is now in session for a %@ trial.\nCase number %@: ‘%@’.\nEveryone, please sit up nicely!”"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ says out loud:\n\n‘%@ is now in session for a %@ trial.\nCase number %@: “%@”.\nEveryone, please sit up nicely!’"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が大きな声で言います：\n\n「ただいまから、%@の%@裁判を始めます。\n事件番号%@、『%@』事件です。\nみなさん、きちんとすわってください！」"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@大声宣布：\n\n“现在，%@开庭审理%@案件。\n案号%@，「%@」案。\n请大家坐好！”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@大聲宣布：\n\n「現在，%@開庭審理%@案件。\n案號%@，『%@』案。\n請大家坐好！」"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ громко объявляет:\n\n«Внимание! %@ начинает заседание. Вид дела: %@.\nДело № %@ — „%@“.\nПожалуйста, сядьте ровно!»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, di en voz alta:\n\n«%@: se abre la sesión (%@).\nCaso n.º %@, “%@”.\n¡Sentaos bien, por favor!»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – laut sagen:\n\n„%@ tagt jetzt. Die Verhandlung beginnt: %@.\nAktenzeichen %@, Fall ‚%@‘.\nBitte setzt euch alle ordentlich hin!“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, dis bien fort :\n\n« Ici %@ : l’audience (%@) est ouverte !\nAffaire n° %@ : “%@”.\nTout le monde s’assoit bien, s’il vous plaît ! »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, di’ ad alta voce:\n\n«%@: si apre l’udienza (%@)!\nCaso n. %@, “%@”.\nTutti seduti composti, per favore!»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, diga em voz alta:\n\n\"Declaro aberta a sessão. %@ — julgamento %@.\nProcesso nº %@, caso “%@”.\nTodos sentados direitinho, por favor!\""
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@พูดเสียงดังว่า:\n\n“ณ บัดนี้ %@ ขอเริ่มการพิจารณาคดี%@\nคดีหมายเลข %@ เรื่อง ‘%@’\nทุกคนนั่งให้เรียบร้อยด้วย!”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nói thật to:\n\n“Bây giờ, %@ xin bắt đầu phiên tòa %@.\nVụ số %@, vụ ‘%@’.\nMọi người ngồi ngay ngắn nhé!”"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nahlas oznamuje:\n\n„Pozor! %@ zahajuje líčení. Druh případu: %@.\nPřípad č. %@ — ‚%@‘.\nPosaďte se, prosím, rovně!“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – sig højt:\n\n»%@ er nu sat. Vi begynder: %@.\nSagsnummer %@, sagen ’%@’.\nSæt jer alle sammen pænt ned!«"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (δυνατά):\n\n«%@ — η συνεδρίαση αρχίζει!\nΕίδος υπόθεσης: %@.\nΑριθμός υπόθεσης %@: “%@”.\nΚαθίστε όλοι σωστά, παρακαλώ!»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sanoo kovalla äänellä:\n\n”%@ – istunto alkaa nyt (%@).\nAsian numero on %@: ’%@’.\nIstukaa kaikki nätisti!”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ berkata dengan lantang:\n\n\"Sidang %3$@ %2$@ dengan ini dibuka.\nNomor perkara %4$@, perkara “%5$@”.\nSemuanya, duduk yang rapi ya!\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sier høyt:\n\n«Nå begynner rettssaken i %@ (%@).\nSak nummer %@: ‘%@’.\nSett dere pent, alle sammen!»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – zeg hardop:\n\n“%@ is nu in zitting. We beginnen: %@.\nZaaknummer %@, de zaak ‘%@’.\nGa allemaal netjes zitten!”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ głośno ogłasza:\n\n„Uwaga! %@ rozpoczyna rozprawę. Rodzaj sprawy: %@.\nSprawa nr %@ — »%@«.\nProszę, usiądźcie prosto!”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ säger högt:\n\n”Nu börjar rättegången i %@ (%@).\nMål nummer %@: ’%@’.\nSätt er fint, allihop!”"
