    "단계별 대본과 타이머, 의사봉이\n재판을 도와줘요.\n판결이 나면 꼭 서로 안아주고 화해해요 🤗" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step-by-step scripts, a timer and a gavel\nhelp run the trial.\nAfter the verdict, always hug and make up 🤗"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step-by-step scripts, a timer and a gavel\nhelp run the trial.\nAfter the verdict, always hug and make up 🤗"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段階ごとのせりふとタイマー、木槌が\n裁判を手伝ってくれます。\n判決が出たら、かならずハグして仲直りしよう 🤗"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分步骤的台词、计时器和法槌\n会帮你完成审判。\n判决出来后，一定要互相抱一抱、和好哦 🤗"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分步驟的台詞、計時器和法槌\n會幫你完成審判。\n判決出來後，一定要互相抱抱、和好喔 🤗"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошаговый сценарий, таймер и молоток\nпомогут провести суд.\nПосле приговора обязательно обнимитесь и помиритесь 🤗"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un guion paso a paso, un temporizador\ny un mazo te ayudan en el juicio.\nTras la sentencia, abrazo y paces hechas 🤗"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Skript für jeden Schritt, ein Timer und der Hammer\nhelfen bei der Verhandlung.\nNach dem Urteil: in den Arm nehmen und vertragen 🤗"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un texte étape par étape, un minuteur\net un marteau t’aident pendant le procès.\nAprès le verdict, câlin et réconciliation 🤗"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un copione passo passo, un timer\ne il martelletto ti aiutano nel processo.\nDopo la sentenza, abbraccio e pace fatta 🤗"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roteiro passo a passo, cronômetro e martelo\najudam no julgamento.\nDepois da sentença, abracem-se e façam as pazes 🤗"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บทพูดทีละขั้น ตัวจับเวลา และค้อน\nช่วยให้การพิจารณาคดีราบรื่น\nตัดสินแล้วอย่าลืมกอดกันและคืนดีกันนะ 🤗"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kịch bản từng bước, đồng hồ và búa\nsẽ giúp phiên tòa diễn ra.\nTuyên án xong nhớ ôm nhau và làm lành 🤗"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scénář krok za krokem, časovač a kladívko\nvám pomohou vést soud.\nPo rozsudku se nezapomeňte obejmout a usmířit 🤗"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et manuskript for hvert trin, en timer og en hammer\nhjælper jer gennem retsmødet.\nEfter dommen: et kram, og så er I gode venner igen 🤗"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σενάριο βήμα βήμα, χρονόμετρο και σφυρί\nβοηθούν στη δίκη.\nΜετά την απόφαση, αγκαλιαστείτε και τα βρείτε 🤗"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaiheittainen käsikirjoitus, ajastin ja nuija\nauttavat oikeudenkäynnissä.\nKun tuomio on annettu, halatkaa ja sopikaa 🤗"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskah per tahap, timer, dan palu\nmembantu jalannya sidang.\nSetelah putusan, jangan lupa berpelukan dan berbaikan 🤗"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et manus steg for steg, en tidtaker og en hammer\nhjelper dere gjennom rettssaken.\nNår dommen er klar, gir dere hverandre en klem 🤗"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een script voor elke stap, een timer en een hamer\nhelpen je tijdens de zitting.\nNa de uitspraak: knuffelen en het goedmaken 🤗"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scenariusz krok po kroku, minutnik i młotek\npomogą poprowadzić proces.\nPo wyroku koniecznie się przytulcie i pogódźcie 🤗"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett manus steg för steg, en timer och en klubba\nhjälper er genom rättegången.\nNär domen är klar kramas ni och blir sams 🤗"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adım adım senaryo, zamanlayıcı ve tokmak\nduruşmada size yardım eder.\nKarar çıkınca mutlaka sarılıp barışın 🤗"
          }
        }
      }
    },
