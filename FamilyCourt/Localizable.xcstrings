    "판사도 접수하는 사람이 직접 골라요. 사건과 관련 없는 사람이 좋아요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person filing picks the judge too. Someone not involved in the case is best!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person filing picks the judge too. Someone not involved in the case is best!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判官も、申し立てる人が自分で選びます。事件に関係ない人がいいですね！"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法官也由提交的人自己选。最好选和案件无关的人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法官也由提出的人自己選。最好選跟案件無關的人！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Судью тоже выбирает тот, кто подаёт дело. Лучше, чтобы это был человек, не связанный с делом!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juez también lo elige quien presenta el caso. ¡Mejor alguien que no tenga nada que ver!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Richter sucht auch aus, wer den Fall einreicht. Am besten jemand, der nicht am Fall beteiligt ist!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est aussi toi qui choisis le juge. Mieux vaut quelqu’un qui n’est pas mêlé à l’affaire !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche il giudice lo sceglie chi presenta la causa. Meglio qualcuno che non c’entra con il caso!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abre o processo escolhe também o juiz. De preferência, alguém de fora do caso!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ยื่นฟ้องเลือกผู้พิพากษาเองด้วย คนที่ไม่เกี่ยวกับคดีจะดีที่สุด!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẩm phán cũng do người nộp đơn tự chọn. Nên là người không liên quan đến vụ việc!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soudce vybírá taky ten, kdo případ podává. Nejlepší je někdo, kdo s případem nesouvisí!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der anlægger sagen, vælger også dommeren. Helst en, der ikke har noget med sagen at gøre!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και τον δικαστή τον διαλέγει όποιος καταθέτει την υπόθεση. Καλύτερα κάποιος χωρίς σχέση με την υπόθεση!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asian jättäjä valitsee myös tuomarin. Valitse joku, joka ei liity asiaan!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakim juga dipilih sendiri oleh yang mengajukan. Sebaiknya orang yang tidak terlibat perkara!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som leverer saken, velger også dommeren. Velg en som ikke har noe med saken å gjøre!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de zaak indient, kiest ook de rechter. Het liefst iemand die niets met de zaak te maken heeft!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sędziego też wybiera ten, kto składa sprawę. Najlepiej ktoś niezwiązany ze sprawą!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som lämnar in målet väljer också domaren. Välj någon som inte har med målet att göra!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakimi de davayı açan kişi seçer. Davayla ilgisi olmayan biri en iyisi!"
          }
        }
      }
    },
