      "comment" : "Roadmap item detail: reduce motion",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임 줄이기를 켜면 화면 효과가 차분해져요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」をオンにすると、画面効果が穏やかになります。"
