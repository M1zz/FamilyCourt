    "설정의 [어휘 난이도]를 '쉬운 말'로 고르면 판사는 심판, 원고는 억울한 사람처럼 쉬운 말로 보여요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set [Word Level] in Settings to “Simple” and words like Judge and Plaintiff become Referee and Upset One."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set [Word Level] in Settings to “Simple” and words like Judge and Plaintiff become Referee and Upset One."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［設定］の［ことばのレベル］で「やさしいことば」を選ぶと、裁判官は「しんぱん」、原告は「くやしい思いをした人」のように、やさしいことばで表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在[设置]的[用语难度]里选“简单”，法官会显示为“小裁判”，原告会显示为“觉得委屈的人”，换成简单的说法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在[設定]的[用語難度]選「簡單」，法官會顯示成「小裁判」，原告會顯示成「覺得委屈的人」，換成簡單的說法。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери в настройках [Сложность слов] → «Простой», и вместо «судья» будет «рефери», а вместо «истец» — «обиженный»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los ajustes, elige «Sencillo» en [Nivel de vocabulario] y verás palabras fáciles: juez será árbitro, demandante será quien se queja, etc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählst du in den Einstellungen bei [Sprachstufe] „Einfach“, erscheinen leichte Wörter: Aus dem Richter wird der Schiri, aus dem Kläger „Wer sich beschwert“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les réglages, choisis « Simple » pour [Niveau de vocabulaire] : juge devient arbitre, demandeur devient celui qui se plaint, et ainsi de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle impostazioni scegli «Semplice» in [Livello del linguaggio]: giudice diventa arbitro, attore diventa chi ha subito un torto, e così via."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em [Nível das palavras], nos Ajustes, escolha “Fácil”: o juiz vira árbitro, e o autor vira quem reclama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเลือก “คำง่าย ๆ” ใน [ระดับคำศัพท์] ของการตั้งค่า จะเห็นคำง่าย ๆ เช่น กรรมการแทนผู้พิพากษา และคนที่รู้สึกไม่ยุติธรรมแทนโจทก์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn [Mức độ từ ngữ] trong Cài đặt là “Dễ hiểu” thì Thẩm phán sẽ thành Trọng tài, Nguyên đơn thành Người bị oan cho dễ hiểu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavení vyber [Obtížnost slov] → „Jednoduchá“ a místo „soudce“ uvidíš „rozhodčí“, místo „žalobce“ zase „ukřivděný“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg »Enkelt« under [Ordniveau] i indstillingerne, så bliver ordene lette: Dommeren bliver til bestemmeren, og sagsøgeren til »den, der klager«."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις Ρυθμίσεις, στο [Επίπεδο λεξιλογίου], διάλεξε «Απλά λόγια» και θα βλέπεις απλές λέξεις, όπως Διαιτητής αντί για Δικαστής και Όποιος αδικήθηκε αντί για Ενάγων."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse Asetusten kohdasta [Sanataso] ”Helppo”, niin näet helpompia sanoja, kuten Erotuomari eikä Tuomari tai Epäreilun kokenut eikä Kantaja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih 'Kata mudah' di [Tingkat kosakata] pada Pengaturan, maka Hakim jadi Wasit dan Penggugat jadi Yang Merasa Tak Adil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg «Enkelt» under [Ordnivå] i Innstillinger, så vises enklere ord, for eksempel Bestemmeren i stedet for Dommeren og Den som synes det er urettferdig i stedet for Saksøkeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies in de instellingen bij [Woordniveau] ‘Makkelijk’, dan zie je makkelijke woorden: de rechter wordt de scheidsrechter en de eiser ‘wie het oneerlijk vindt’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz w ustawieniach [Poziom słownictwa] → „Prosty”, a zamiast „sędzia” pojawi się „rozjemca”, a zamiast „powód” — „poszkodowany”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ”Enkel” under [Ordnivå] i Inställningar så visas enklare ord, till exempel Bestämmaren i stället för Domaren och Den som tycker det är orättvist i stället för Käranden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar’daki [Kelime düzeyi] bölümünden “Kolay dil”i seçerseniz Hakim yerine Hakem, Davacı yerine Haksızlığa uğrayan gibi kolay kelimeler görünür."
          }
        }
      }
    },
