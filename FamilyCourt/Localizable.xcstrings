    "억울한 일도, 약속을 어긴 일도\n가족이 함께 여는 재판으로 풀어요.\n서로의 이야기를 끝까지 듣는 연습이 돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unfair moments and broken promises\nget sorted out in a family trial.\nIt's great practice for hearing each other out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unfair moments and broken promises\nget sorted out in a family trial.\nIt's great practice for hearing each other out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "くやしいことも、約束やぶりも、\n家族みんなで開く裁判で解決。\nおたがいの話を最後まで聞く練習になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委屈的事、说话不算话的事，\n都能通过全家一起开的法庭来解决。\n还能练习把对方的话听完。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委屈的事、說話不算話的事，\n都能透過全家一起開的法庭來解決。\n還能練習把對方的話聽完。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "И обиды, и нарушенные обещания\nрешаем на семейном суде.\nТак мы учимся дослушивать друг друга."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo injusto y las promesas rotas\nse resuelven con un juicio en familia.\nAsí se aprende a escuchar hasta el final."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob etwas ungerecht war oder eine Regel gebrochen wurde:\nIhr klärt es gemeinsam vor eurem Familiengericht.\nSo übt ihr, einander bis zum Ende zuzuhören."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injustices ou promesses pas tenues :\non règle tout par un procès en famille.\nOn apprend à écouter l’autre jusqu’au bout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torti subiti o promesse infrante:\nsi risolve tutto con un processo in famiglia.\nCosì si impara ad ascoltare fino in fondo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injustiças e promessas quebradas\nse resolvem num julgamento em família.\nÉ um treino para ouvir o outro até o fim."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทั้งเรื่องไม่แฟร์และเรื่องผิดสัญญา\nแก้ได้ด้วยศาลที่ครอบครัวเปิดด้วยกัน\nได้ฝึกฟังกันและกันจนจบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyện oan ức hay chuyện thất hứa\nđều giải quyết bằng phiên tòa cả nhà cùng mở.\nCùng tập lắng nghe nhau đến hết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Křivdy i porušené sliby\nřešíme rodinným soudem.\nUčíme se tak vyslechnout jeden druhého až do konce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget uretfærdigt eller et brudt løfte?\nLøs det sammen med en retssag derhjemme.\nSå øver I jer i at lytte til hinanden hele vejen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αδικίες και αθετημένες υποσχέσεις\nλύνονται με μια δίκη όλοι μαζί.\nΜαθαίνετε να ακούτε ο ένας τον άλλον ως το τέλος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epäreilut jutut ja rikotut lupaukset\nratkaistaan koko perheen oikeudenkäynnissä.\nSamalla harjoitellaan kuuntelemaan toista loppuun asti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlakuan tidak adil maupun janji yang dilanggar\ndiselesaikan lewat sidang bersama keluarga.\nKita jadi terlatih mendengarkan sampai selesai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urettferdigheter og brutte løfter\nløser dere i en rettssak med hele familien.\nDere øver på å høre hverandre helt ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets oneerlijks of een gebroken afspraak?\nLos het samen op met een zitting thuis.\nZo oefen je om elkaar helemaal uit te laten praten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krzywdy i złamane obietnice\nrozwiązujemy w rodzinnym procesie.\nTo nauka słuchania siebie nawzajem do końca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orättvisor och brutna löften\nlöser ni i en rättegång med hela familjen.\nNi övar på att lyssna på varandra till slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haksızlıkları da tutulmayan sözleri de\nailece kurulan bir mahkemede çözün.\nBirbirinizi sonuna kadar dinlemeyi öğrenirsiniz."
          }
        }
      }
    },
    "억울한 일을 겪어서 재판을 신청한 사람이에요. %@ 재판에서 이야기를 시작해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person who felt wronged and asked for a trial. They're the first to speak in a %@ trial."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person who felt wronged and asked for a trial. They're the first to speak in a %@ trial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "くやしい思いをして、裁判を申し立てた人です。%@の裁判で、最初に話します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到委屈的事，申请审判的人。在%@审判中第一个发言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到委屈的事、申請審判的人。在%@審判中第一個發言。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот, с кем поступили несправедливо и кто попросил о суде. В деле «%@» он рассказывает первым."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es quien ha sufrido algo injusto y pide el juicio. En el caso «%@» es quien empieza a hablar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat etwas Ungerechtes erlebt und den Fall eingereicht. Fängt in der Verhandlung (%@) mit dem Erzählen an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la personne qui a vécu quelque chose d’injuste et qui demande un procès. Dans un procès « %@ », c’est elle qui parle en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È chi ha subito un torto e chiede il processo. Nella causa «%@» è il primo a parlare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem passou por uma injustiça e pediu o julgamento. É quem começa falando no julgamento (%@)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่เจอเรื่องไม่ยุติธรรมจึงขอเปิดศาล เป็นคนแรกที่เล่าเรื่องในคดี%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người gặp chuyện oan ức và nộp đơn xin xử. Là người mở đầu câu chuyện trong phiên xử %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten, komu se stala křivda a kdo požádal o soud. V případu „%@“ začíná vyprávět jako první."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har oplevet noget uretfærdigt og anlagt sagen. Begynder med at fortælle i retsmødet (%@)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αδικήθηκε και ζήτησε τη δίκη. Μιλά πρώτος στη δίκη (%@)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, jolle on tapahtunut jotain epäreilua ja joka hakee oikeudenkäyntiä. Aloittaa kertomisen oikeudenkäynnissä (%@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang merasa diperlakukan tidak adil lalu mengajukan sidang. Dialah yang pertama bercerita di sidang (%@)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har opplevd noe urettferdig og ber om rettssak. Begynner å fortelle i rettssaken (%@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft iets oneerlijks meegemaakt en de zaak ingediend. Begint in de zitting (%@) met vertellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś, kogo spotkała niesprawiedliwość i kto poprosił o proces. W sprawie „%@” zaczyna opowiadać jako pierwszy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har varit med om något orättvist och begär rättegång. Börjar berätta i rättegången (%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haksızlığa uğradığı için davayı açan kişidir. Duruşmada (%@) ilk o konuşur."
          }
        }
      }
    },
    "억울한 일을 민사 소송으로 접수하는 화면을 열어요." : {
      "localizations" : {
