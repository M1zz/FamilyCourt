    "잘못과 연결된 벌칙이 가장 교육적이에요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penalties linked to what went wrong teach the most."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penalties linked to what went wrong teach the most."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まちがいにつながった罰が、いちばんの学びになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和错误相关的惩罚最有教育意义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟錯誤有關的處罰最有教育意義。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наказание, связанное с проступком, учит лучше всего."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sanción más educativa es la que tiene que ver con lo que se hizo mal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am meisten lernt man, wenn die Strafe zum Fehler passt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sanction liée à la faute, c’est ce qui aide le plus à grandir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sanzione legata allo sbaglio è quella che insegna di più."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pena ligada ao erro é a que mais ensina."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บทลงโทษที่เชื่อมกับความผิดสอนได้ดีที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình phạt gắn với lỗi lầm là hình phạt dạy được nhiều nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trest, který souvisí s proviněním, učí nejvíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man lærer mest af en straf, der passer til fejlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμωρίες που συνδέονται με το λάθος διδάσκουν περισσότερο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangaistuksesta, joka liittyy tekoon, oppii eniten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukuman yang terkait dengan kesalahannya paling mendidik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En straff som henger sammen med det man gjorde, lærer man mest av."
