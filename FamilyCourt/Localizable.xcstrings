        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@说出希望什么样的惩罚：\n\n“请给%@以下惩罚：\n%@”\n\n⭐ 惩罚不要太重，要做得到！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@說出希望什麼樣的處罰：\n\n「請給%@以下處罰：\n%@」\n\n⭐ 處罰不要太重，要做得到！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ предлагает наказание:\n\n«Прошу назначить такое наказание (%@):\n%@»\n\n⭐ Наказание — не слишком строгое и выполнимое!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, di qué sanción sería justa:\n\n«Pido esta sanción para %@:\n%@»\n\n⭐ ¡Una sanción no muy dura, que se pueda cumplir!"
          }
        },
        "de" : {
          "stringUnit" : {
