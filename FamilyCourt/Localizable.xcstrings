    "심판도 신청하는 사람이 직접 골라요. 싸움과 상관없는 사람이 좋아요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person asking for the trial picks the Referee too. Someone who's not part of the fight is best!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person asking for the trial picks the Referee too. Someone who's not part of the fight is best!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しんぱんも、おねがいする人が自分でえらぶよ。けんかに関係ない人がいいね！"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小裁判也由申请的人自己选。最好选和吵架没关系的人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小裁判也由申請的人自己選。最好選跟吵架沒關係的人！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рефери тоже выбирает тот, кто просит о суде. Лучше, чтобы это был тот, кто в ссоре не участвует!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El árbitro también lo elige quien pide el juicio. ¡Mejor alguien que no esté en la pelea!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Schiri suchst du auch selbst aus. Am besten jemand, der beim Streit nicht dabei war!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est aussi toi qui choisis l’arbitre. Mieux vaut quelqu’un qui n’est pas dans la dispute !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche l’arbitro lo sceglie chi chiede il processo. Meglio qualcuno che non c’entra con il litigio!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem pede o julgamento escolhe também o árbitro. De preferência, alguém que não está na briga!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ขอเปิดศาลเลือกกรรมการเองด้วย คนที่ไม่เกี่ยวกับเรื่องทะเลาะจะดีที่สุด!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trọng tài cũng do người xin xử tự chọn. Nên chọn người không dính tới chuyện cãi nhau!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozhodčího vybírá taky ten, kdo žádá o soud. Nejlepší je někdo, kdo se hádky neúčastní!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestemmeren vælger du også selv. Helst en, der ikke var med i skænderiet!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και τον διαιτητή τον διαλέγει όποιος ζητά τη δίκη. Καλύτερα κάποιος που δεν έχει σχέση με τον καβγά!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oikeudenkäyntiä hakeva valitsee myös erotuomarin. Valitse joku, joka ei ole mukana riidassa!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasit juga dipilih sendiri oleh yang mengajukan. Sebaiknya orang yang tidak ikut bertengkar!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som ber om rettssaken, velger også bestemmeren. Velg en som ikke er med i krangelen!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De scheidsrechter kies je ook zelf. Het liefst iemand die niets met de ruzie te maken heeft!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozjemcę też wybiera ten, kto prosi o proces. Najlepiej ktoś, kto nie bierze udziału w kłótni!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som begär rättegången väljer också bestämmaren. Välj någon som inte är med i bråket!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakemi de davayı açan kişi seçer. Kavgayla ilgisi olmayan biri en iyisi!"
          }
        }
      }
    },
