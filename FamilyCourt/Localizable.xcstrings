    "양쪽 이야기를 끝까지 듣고 공정하게 정해요. 사건과 관련 없는 사람이 맡고, 재판을 신청하는 사람이 골라요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens to both sides all the way through and decides fairly. It should be someone not involved in the case, chosen by the person who asks for the trial."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens to both sides all the way through and decides fairly. It should be someone not involved in the case, chosen by the person who asks for the trial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の話を最後まで聞いて、公平に決めます。事件に関係ない人がつとめ、裁判を申し立てる人が選びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把双方的话听完，公平地做出决定。由和案件无关的人担任，由申请审判的人来选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把雙方的話聽完，公平地做出決定。由跟案件無關的人擔任，由申請審判的人來選。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выслушивает обе стороны до конца и решает честно. Это должен быть тот, кто не участвует в деле, а выбирает его тот, кто подаёт в суд."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha a las dos partes hasta el final y decide con justicia. Es alguien que no tiene nada que ver con el caso, y lo elige quien pide el juicio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört beide Seiten bis zum Ende an und entscheidet fair. Es muss jemand sein, der nicht am Fall beteiligt ist. Ausgesucht wird er von der Person, die den Fall einreicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute les deux côtés jusqu’au bout et décide de façon juste. C’est quelqu’un qui n’est pas mêlé à l’affaire, choisi par la personne qui demande le procès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta fino in fondo tutte e due le parti e decide in modo giusto. È qualcuno che non c’entra con il caso, scelto da chi chiede il processo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouve os dois lados até o fim e decide com justiça. Deve ser alguém de fora do caso, escolhido por quem pede o julgamento."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังทั้งสองฝ่ายจนจบแล้วตัดสินอย่างยุติธรรม ต้องเป็นคนที่ไม่เกี่ยวกับคดี และคนที่ขอเปิดศาลเป็นคนเลือก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe hết lời cả hai bên rồi quyết định công bằng. Nên là người không liên quan đến vụ việc, do người nộp đơn chọn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyslechne obě strany až do konce a rozhodne spravedlivě. Měl by to být někdo, kdo s případem nesouvisí, a vybírá ho ten, kdo případ podává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytter til begge sider hele vejen og afgør det retfærdigt. Det skal være en, der ikke har noget med sagen at gøre, og den vælges af den, der anlægger sagen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακούει ως το τέλος και τις δύο πλευρές και αποφασίζει δίκαια. Πρέπει να μην έχει σχέση με την υπόθεση· τον διαλέγει όποιος ζητά τη δίκη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntelee molempia osapuolia loppuun asti ja päättää reilusti. Tehtävään valitaan joku, joka ei liity asiaan, ja hänet valitsee oikeudenkäyntiä hakeva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendengarkan kedua pihak sampai selesai dan memutuskan dengan adil. Dipegang orang yang tidak terlibat, dan dipilih oleh yang mengajukan sidang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hører på begge sider helt til slutt og bestemmer rettferdig. Skal være en som ikke har noe med saken å gjøre, og velges av den som ber om rettssaken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luistert tot het einde naar beide kanten en beslist eerlijk. Het is iemand die niets met de zaak te maken heeft, gekozen door wie de zaak indient."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłuchuje obu stron do końca i sprawiedliwie decyduje. Powinna to być osoba niezwiązana ze sprawą, a wybiera ją ten, kto składa sprawę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssnar på båda sidor till slut och bestämmer rättvist. Ska vara någon som inte har med målet att göra, och väljs av den som begär rättegången."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki tarafı da sonuna kadar dinler ve adil karar verir. Davayla ilgisi olmayan biri olmalı; onu davayı açan kişi seçer."
          }
        }
      }
    },
    "어긴 법 고르기" : {
