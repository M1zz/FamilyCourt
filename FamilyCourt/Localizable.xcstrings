    "다음 재판에서 상대편 도와주는 역할 맡기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be the other side's helper in the next trial"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be the other side's helper in the next trial"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の裁判で、相手を助ける役をする"
