          }
        }
      }
    },
    "재판이 끝나면 결과와 상관없이 서로 안아주고 화해한다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a trial is over, whatever the result, we hug and make up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a trial is over, whatever the result, we hug and make up."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判が終わったら、結果にかかわらずハグして仲直りする。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审判结束后，不管结果怎样，都要互相抱一抱、和好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "審判結束後，不管結果如何，都要互相抱抱、和好。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После суда, каким бы ни был итог, обнимаемся и миримся."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al acabar el juicio, salga como salga, nos abrazamos y hacemos las paces."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jeder Verhandlung nehmen wir uns in den Arm und vertragen uns, egal wie das Urteil ausfällt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la fin d’un procès, quel que soit le résultat, on se fait un câlin et on se réconcilie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla fine del processo, comunque vada, ci si abbraccia e si fa pace."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fim do julgamento, seja qual for o resultado, todos se abraçam e fazem as pazes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จบการพิจารณาแล้ว ไม่ว่าผลจะเป็นอย่างไร ให้กอดกันและคืนดีกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử xong, dù kết quả thế nào, cả nhà cũng ôm nhau và làm lành."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po soudu se bez ohledu na výsledek obejmeme a usmíříme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter hvert retsmøde giver vi hinanden et kram og bliver gode venner, uanset dommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά τη δίκη, όποιο κι αν είναι το αποτέλεσμα, αγκαλιαζόμαστε και τα βρίσκουμε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun oikeudenkäynti on ohi, halataan ja sovitaan, oli tuomio mikä tahansa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah sidang selesai, apa pun hasilnya, saling berpelukan dan berbaikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når rettssaken er over, gir vi hverandre en klem og blir venner, uansett hvordan dommen ble."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na elke zitting knuffelen we en maken we het goed, wat de uitspraak ook is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po procesie, bez względu na wynik, przytulamy się i godzimy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När rättegången är slut kramas vi och blir sams, hur domen än blev."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duruşma bitince, sonuç ne olursa olsun, birbirimize sarılıp barışırız."
          }
        }
      }
    },
