            "value" : "%@:\n\n“%@ก็มีเหตุผลแบบนี้อยู่...”\n“%@สำนึกผิดแบบนี้แล้ว...”\n\nช่วยหาเหตุผลดี ๆ มาปกป้อง%@กันเถอะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n“%@ cũng có lý do riêng...”\n“%@ đang hối lỗi như thế này...”\n\nHãy tìm những lý do tốt để bảo vệ %@!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n„%@ chce vysvětlit, proč to tak dopadlo…“\n„%@ upřímně lituje toho, co se stalo…“\n\nHledej dobré důvody pro obhajobu! (%@)"
