    "재판을 기다리는 사건이 없어요.\n평화로운 우리 집!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cases are waiting for trial.\nAll's peaceful at home!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cases are waiting for trial.\nAll's calm at home!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁判を待っている事件はありません。\n平和なわが家！"
