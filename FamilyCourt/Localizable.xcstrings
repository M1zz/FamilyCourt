    "[가족] 탭에서 재판에 함께할 가족을 추가해요.\n누구든 사건에 따라 판사도, 원고도,\n변호인도 될 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the [Family] tab, add everyone who'll take part.\nDepending on the case, anyone can be\nthe judge, the plaintiff or the defense lawyer."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the [Family] tab, add everyone who'll take part.\nDepending on the case, anyone can be\nthe judge, the plaintiff or the defence lawyer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［家族］タブで、裁判にいっしょに参加する家族を追加します。\n事件によって、だれでも裁判官にも、原告にも、\n弁護人にもなれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在[家人]标签里添加一起参加审判的家人。\n根据案件不同，每个人都可以当法官、原告，\n也可以当辩护人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在[家人]分頁新增一起參加審判的家人。\n依照案件不同，每個人都可以當法官、原告，\n也可以當辯護人。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во вкладке [Семья] добавь тех, кто будет участвовать.\nВ разных делах каждый может быть\nсудьёй, истцом или защитником."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pestaña [Familia], añade a quienes van a participar.\nSegún el caso, cualquiera puede ser juez,\ndemandante o abogado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge im Tab [Familie] alle hinzu, die mitmachen.\nJe nach Fall kann jede und jeder Richter,\nKläger oder Verteidiger sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’onglet [Famille], ajoute ceux qui participeront.\nSelon l’affaire, chacun peut être juge,\ndemandeur ou avocat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella scheda [Famiglia] aggiungi chi partecipa ai processi.\nA seconda del caso, chiunque può essere giudice,\nattore o difensore."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na aba [Família], adicione quem vai participar.\nDependendo do caso, qualquer um pode ser\njuiz, autor ou advogado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มสมาชิกที่จะร่วมพิจารณาคดีในแท็บ [ครอบครัว]\nทุกคนเป็นได้ทั้งผู้พิพากษา โจทก์\nหรือทนายความ แล้วแต่คดี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm những người sẽ cùng xử án ở tab [Gia đình].\nTùy từng vụ, ai cũng có thể là thẩm phán,\nnguyên đơn hay luật sư."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kartě [Rodina] přidej ty, kdo budou u soudu.\nPodle případu může být každý\nsoudcem, žalobcem i obhájcem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj alle, der skal være med, under fanen [Familie].\nAlt efter sagen kan alle være dommer,\nsagsøger eller forsvarer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην καρτέλα [Οικογένεια] πρόσθεσε όσους θα παίρνουν μέρος.\nΑνάλογα με την υπόθεση, ο καθένας μπορεί να γίνει\nδικαστής, ενάγων ή συνήγορος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kaikki osallistujat [Perhe]-välilehdellä.\nKuka tahansa voi asiasta riippuen olla\ntuomari, kantaja tai avustaja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tab [Keluarga], tambahkan anggota yang ikut sidang.\nSiapa saja bisa jadi hakim, penggugat,\natau pembela, tergantung perkaranya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til alle som skal være med, under fanen [Familie].\nHvem som helst kan være dommer, saksøker\neller forsvarer, alt etter saken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg in het tabblad [Gezin] iedereen toe die meedoet.\nAfhankelijk van de zaak kan iedereen rechter,\neiser of advocaat zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W karcie [Rodzina] dodaj osoby, które wezmą udział w procesie.\nW zależności od sprawy każdy może być\nsędzią, powodem albo obrońcą."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till alla som ska vara med under fliken [Familj].\nVem som helst kan vara domare, kärande\neller försvarare, beroende på målet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Aile] sekmesinden duruşmalara katılacak kişileri ekle.\nDavaya göre herkes hakim, davacı\nya da avukat olabilir."
          }
        }
      }
    },
    "[법원] 탭에서 억울한 일은 민사로,\n우리 집 법을 어긴 일은 형사로 접수해요.\n누구를 부를지, 누가 판사를 볼지도 직접 정해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the [Court] tab, file unfair things as civil cases\nand broken house rules as criminal cases.\nYou choose who to call and who will be the judge."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the [Court] tab, file unfair things as civil cases\nand broken house rules as criminal cases.\nYou choose who to call and who will be the judge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［裁判所］タブで、くやしいことは民事で、\nわが家の法律がやぶられたことは刑事で申し立てます。\nだれを呼ぶか、だれが裁判官をするかも自分で決めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在[法院]标签里，委屈的事提起民事诉讼，\n违反家规的事提起刑事诉讼。\n叫谁来、请谁当法官，也都自己决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在[法院]分頁，委屈的事提起民事訴訟，\n違反家規的事提起刑事訴訟。\n要叫誰來、請誰當法官，也都自己決定。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во вкладке [Суд] обиду подают как гражданское дело,\nа нарушение домашнего правила — как уголовное.\nТы сам решаешь, кого позвать и кто будет судьёй."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pestaña [Tribunal], lo injusto va como caso civil\ny una ley de casa incumplida, como caso penal.\nTú decides a quién llamar y quién será el juez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Tab [Gericht] reichst du Ungerechtes als Zivilsache\nund gebrochene Hausregeln als Strafsache ein.\nDu bestimmst selbst, wer gerufen wird und wer Richter ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’onglet [Tribunal], une injustice devient une affaire civile,\nune loi de la maison enfreinte, une affaire pénale.\nTu choisis aussi qui appeler et qui sera juge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella scheda [Tribunale] un torto diventa una causa civile,\nuna legge di casa violata una causa penale.\nDecidi tu chi chiamare e chi farà il giudice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na aba [Tribunal], injustiças viram casos cíveis\ne leis da casa desrespeitadas, casos criminais.\nVocê escolhe quem chamar e quem será o juiz."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแท็บ [ศาล] เรื่องไม่ยุติธรรมยื่นเป็นคดีแพ่ง\nเรื่องทำผิดกฎบ้านยื่นเป็นคดีอาญา\nเลือกเองว่าจะเรียกใครและใครเป็นผู้พิพากษา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở tab [Tòa án], chuyện oan ức nộp thành vụ dân sự,\nchuyện vi phạm luật nhà mình nộp thành vụ hình sự.\nTự chọn gọi ai ra tòa và ai làm thẩm phán."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kartě [Soud] podáš křivdu jako civilní případ\na porušení domácího pravidla jako trestní.\nTy rozhodneš, koho předvolat a kdo bude soudcem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under fanen [Retten] anlægger du noget uretfærdigt som civil sag\nog en brudt husregel som straffesag.\nDu bestemmer selv, hvem der indkaldes, og hvem der er dommer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην καρτέλα [Δικαστήριο] κατάθεσε μια αδικία ως αστική\nκαι μια παράβαση νόμου του σπιτιού ως ποινική υπόθεση.\nΕσύ διαλέγεις ποιον καλείς και ποιος δικάζει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä [Oikeus]-välilehdellä epäreilut jutut riita-asioina\nja kotisääntöjen rikkomiset rikosasioina.\nPäätät itse, kuka kutsutaan ja kuka on tuomari."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tab [Pengadilan], ajukan perlakuan tidak adil sebagai perdata,\ndan pelanggaran hukum rumah sebagai pidana.\nKamu juga yang memilih siapa dipanggil dan siapa hakimnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under fanen [Domstol] leverer du urettferdigheter som sivile saker\nog brutte husregler som straffesaker.\nDu velger selv hvem som innkalles, og hvem som er dommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het tabblad [Rechtbank] dien je iets oneerlijks in als civiele zaak\nen een overtreden huisregel als strafzaak.\nJij kiest wie er wordt opgeroepen en wie de rechter is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W karcie [Sąd] krzywdę zgłaszasz jako sprawę cywilną,\na złamanie domowego prawa — jako karną.\nTo ty wybierasz, kogo wezwać i kto będzie sędzią."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under fliken [Domstol] lämnar du in orättvisor som tvistemål\noch brutna husregler som brottmål.\nDu väljer själv vem som kallas och vem som är domare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Mahkeme] sekmesinden haksızlıkları hukuk davası,\nev kanunu ihlallerini ceza davası olarak aç.\nKimi çağıracağını, kimin hakim olacağını da sen seç."
          }
        }
      }
    },
