        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@朗讀%@做錯了什麼：\n\n「%@%@以下列方式違反了我們家的家規。」\n\n📄 案件內容：%@\n📜 違反的家規：%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ зачитывает, в чём обвиняется %@:\n\n«%@: %@. Вот как было нарушено наше домашнее правило:»\n\n📄 Что случилось: %@\n📜 Нарушенное правило: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, lee lo que se le reprocha a quien va a juicio (%2$@):\n\n«%4$@ (%3$@) ha incumplido la ley de nuestra casa de esta manera.»\n\n📄 Qué pasó: %5$@\n📜 Ley incumplida: %6$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vorlesen, was vorgeworfen wird (%@):\n\n„%@: %@. Folgende Hausregel wurde gebrochen.“\n\n📄 Was passiert ist: %@\n📜 Gebrochene Regel: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, lis ce qu’on reproche à la personne jugée (%2$@) :\n\n« %4$@ (%3$@) a enfreint la loi de notre maison de la façon suivante. »\n\n📄 Ce qui s’est passé : %5$@\n📜 Loi enfreinte : %6$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, leggi cosa viene contestato a chi è processato (%2$@):\n\n«%4$@ (%3$@) ha violato la legge di casa nel modo seguente.»\n\n📄 Cosa è successo: %5$@\n📜 Legge violata: %6$@"
