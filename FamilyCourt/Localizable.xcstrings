    "고소인이 직접 소를 제기합니다. 피고와 재판장은 소를 제기하는 사람이 지정하며, 접수 즉시 소송이 개시됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The complainant files the action personally. The defendant and the presiding judge are designated by the filer, and proceedings commence upon filing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The complainant files the action personally. The defendant and the presiding judge are designated by the filer, and proceedings commence upon filing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原告がみずから訴えを提起します。被告と裁判長は訴えを提起する者が指定し、受理と同時に訴訟が開始されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由原告亲自提起诉讼。被告和审判长由起诉人指定，立案后诉讼即刻开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由原告親自提起訴訟。被告與審判長由起訴人指定，受理後訴訟隨即開始。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истец лично подаёт иск. Ответчика и председательствующего назначает лицо, подающее иск; производство начинается сразу после подачи."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El demandante interpone la demanda personalmente. Designa al demandado y al presidente del tribunal, y el procedimiento se inicia al presentarla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Klage wird vom Kläger selbst erhoben. Beklagten und Vorsitzenden Richter bestimmt die klagende Partei; das Verfahren ist mit Eingang der Klage eröffnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le demandeur introduit lui-même l’action. Il désigne le défendeur et le président du tribunal ; la procédure s’ouvre dès le dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attore promuove personalmente l’azione. Il convenuto e il presidente sono designati da chi promuove l’azione; il procedimento si apre al momento del deposito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próprio autor ajuíza a ação. O réu e o juiz presidente são designados por quem a ajuíza, e o processo se inicia imediatamente após o protocolo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ฟ้องยื่นฟ้องด้วยตนเอง โดยผู้ยื่นฟ้องเป็นผู้กำหนดจำเลยและผู้พิพากษาหัวหน้าคณะ และคดีเริ่มทันทีที่ยื่นฟ้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người khởi kiện tự nộp đơn. Bị đơn và chủ tọa do người khởi kiện chỉ định; vụ kiện được thụ lý ngay khi nộp đơn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žalobce podává žalobu osobně. Žalovaného a předsedu senátu určuje ten, kdo žalobu podává, a řízení začíná okamžikem podání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagsøger anlægger selv sagen. Sagsøgte og retsformand udpeges af sagsøger, og sagen indledes straks ved indgivelsen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ενάγων ασκεί ο ίδιος την αγωγή. Τον εναγόμενο και τον Πρόεδρο του Δικαστηρίου τους ορίζει όποιος την ασκεί· η διαδικασία αρχίζει με την κατάθεση."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantaja panee asian itse vireille. Asian vireille panija nimeää vastaajan ja puheenjohtajan, ja asian käsittely alkaa heti, kun se on jätetty."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penggugat mengajukan gugatan secara langsung. Tergugat dan Hakim Ketua ditunjuk oleh pihak yang mengajukan gugatan, dan perkara dimulai seketika setelah didaftarkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saksøkeren tar selv ut stevning. Den som reiser saken, utpeker saksøkte og rettens leder, og saken innledes straks den er levert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eiser stelt zelf de vordering in. De eisende partij wijst de gedaagde en de voorzitter aan; de procedure begint direct na indiening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powód osobiście wnosi pozew. Pozwanego i przewodniczącego wyznacza osoba wnosząca pozew, a postępowanie rozpoczyna się z chwilą jego złożenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käranden väcker själv talan. Den som väcker talan utser svarande och rättens ordförande, och målet inleds så snart det har lämnats in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davacı davayı bizzat açar. Davalıyı ve mahkeme başkanını davayı açan kişi belirler; dava, başvuru anında başlar."
          }
        }
      }
    },
