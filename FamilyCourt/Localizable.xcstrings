    "다른 사람의 물건은 주인에게 허락을 받고 사용한다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the owner before using someone else's things."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the owner before using someone else's things."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人のものは、持ち主にゆるしをもらってから使う。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用别人的东西之前，要先征得主人同意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用別人的東西之前，要先經過主人同意。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чужие вещи берём только с разрешения хозяина."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar las cosas de otro, se pide permiso a su dueño."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sachen von anderen benutzen wir nur, wenn wir vorher gefragt haben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On demande la permission avant d’utiliser les affaires des autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per usare le cose degli altri si chiede il permesso al proprietario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar as coisas dos outros, peça permissão ao dono."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ของของคนอื่นต้องขออนุญาตเจ้าของก่อนใช้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muốn dùng đồ của người khác phải xin phép chủ trước."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cizí věci si půjčujeme jen se svolením majitele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andres ting bruger vi kun, når vi har spurgt først."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πράγματα των άλλων τα χρησιμοποιούμε μόνο με την άδεια του ιδιοκτήτη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toisen tavaroita käytetään vain omistajan luvalla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakai barang orang lain setelah minta izin pemiliknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi spør eieren om lov før vi bruker andres ting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spullen van een ander gebruik je alleen als je het eerst hebt gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cudze rzeczy bierzemy tylko za zgodą właściciela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi frågar ägaren om lov innan vi använder någon annans saker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başkasının eşyası, sahibinden izin alınarak kullanılır."
          }
        }
      }
    },
