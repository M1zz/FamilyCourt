    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read everything easily, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read everything easily, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたときや色の区別がつきにくいときでも、内容が見やすくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”或不易分辨颜色时，也能轻松看清内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」或不易分辨顏色時，也能輕鬆看清內容。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё хорошо видно, даже если включена повышенная контрастность или трудно различать цвета."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee todo con facilidad, incluso con Aumentar contraste activado o si te cuesta distinguir los colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies alles mühelos, auch mit aktiviertem erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez tout facilement, même avec Augmenter le contraste activé ou si les couleurs sont difficiles à distinguer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi tutto con facilità, anche con Aumenta contrasto attivo o se fai fatica a distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia tudo com facilidade, mesmo com Aumentar Contraste ativado ou se for difícil distinguir as cores."
          }
        }
      }
    },
