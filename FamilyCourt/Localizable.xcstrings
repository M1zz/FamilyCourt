    "기록이 쌓이면 우리 집 판례가 됩니다!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cases pile up, they become your family's precedents!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cases pile up, they become your family's precedents!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録がたまると、わが家の判例になります！"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录多了，就成了我们家的判例！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紀錄累積起來，就成了我們家的判例！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда дел станет больше, здесь появятся ваши семейные прецеденты!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Con el tiempo, los casos serán los precedentes de casa!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder abgeschlossene Fall wird hier zu eurer Familiengeschichte!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fil du temps, les affaires deviendront les précédents de la maison !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il tempo, i casi diventeranno i precedenti di casa!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada caso encerrado fica guardado aqui como exemplo para a família!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อบันทึกสะสมมากขึ้น ก็จะกลายเป็นคดีตัวอย่างของบ้านเรา!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi hồ sơ nhiều lên, chúng sẽ thành án lệ của nhà mình!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až se případy nasbírají, budou z nich vaše rodinné precedenty!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver afsluttet sag bliver til en af familiens domme her!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τον καιρό, οι υποθέσεις γίνονται το αρχείο αποφάσεων του σπιτιού μας!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päättyneistä asioista tulee perheen ennakkotapauksia!"
