    "상대 마음을 상상해 보는 연습이 돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good practice for imagining how the other person feels."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good practice for imagining how the other person feels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手の気持ちを想像する練習になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能练习想象对方的心情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以練習想像對方的心情。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это учит представлять, что чувствует другой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve para practicar imaginar lo que siente el otro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So übt man, sich in andere hineinzuversetzen."
          }
