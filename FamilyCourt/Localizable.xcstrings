    "%@:\n\n\"%@에게도 이런 사정이 있었습니다...\"\n\"%@ 이렇게 반성하고 있습니다...\"\n\n%@ 지켜 주는 좋은 이유를 찾아보세요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n“The %@ had a reason too…”\n“The %@ is sorry, and here's how…”\n\nFind good reasons to stand up for the %@!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n“The %@ had a reason too…”\n“The %@ is sorry, and here's how…”\n\nFind good reasons to stand up for the %@!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：\n\n「%@にも、こんな事情がありました…」\n「%@は、こんなふうに反省しています…」\n\n%@をかばってあげられる、よい理由を見つけてみよう！"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：\n\n“%@也有这样的原因……”\n“%@已经这样反省了……”\n\n帮%@找出好的理由吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：\n\n「%@也有這樣的原因……」\n「%@已經這樣反省了……」\n\n幫%@找出好的理由吧！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n«%@ хочет объяснить, почему так вышло…»\n«%@ искренне жалеет о том, что случилось…»\n\nНайди добрые доводы в защиту! (%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n«Quien va a juicio (%@) también tenía sus motivos…»\n«Y además, %@ está arrepentido de verdad…»\n\n¡Busca buenas razones para defender a: %@!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n„Dafür gab es auch Gründe …“ (%@)\n„Das tut wirklich leid …“ (%@)\n\nSucht gute Gründe, die schützen – für: %@!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ :\n\n« La personne jugée (%@) avait aussi ses raisons… »\n« Et puis, %@ regrette sincèrement… »\n\nTrouve de bonnes raisons pour défendre : %@ !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n«Anche chi è processato (%@) aveva le sue ragioni…»\n«E poi %@ è davvero pentito…»\n\nTrova buoni motivi per difendere: %@!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@:\n\n\"%@ teve seus motivos...\"\n\"%@ já reconheceu o erro...\"\n\nProcure bons motivos para defender quem está no papel de %@!"
          }
        },
        "th" : {
          "stringUnit" : {
