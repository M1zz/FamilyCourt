    "자기가 어지른 것은 자기가 정리한다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean up your own mess."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidy up after yourself."
          }
        },
        "ja" : {
