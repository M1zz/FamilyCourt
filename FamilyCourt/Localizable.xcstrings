    "우리 집 법을 어긴 사람을 본 사람이 검사가 되어 접수해요. 부모님도 검사가 될 수 있어요! 누구를 재판에 넘길지, 판사는 누구인지 검사가 정해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoever saw someone break a house rule becomes the prosecutor and files the case. Parents can be prosecutors too! The prosecutor chooses who goes on trial and who the judge is."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoever saw someone break a house rule becomes the prosecutor and files the case. Parents can be prosecutors too! The prosecutor chooses who goes on trial and who the judge is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わが家の法律をやぶった人を見た人が、検察官になって申し立てます。パパやママも検察官になれます！だれを裁判にかけるか、裁判官をだれにするかは、検察官が決めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看到有人违反家规的人当检察官来提交。爸爸妈妈也可以当检察官！把谁送上法庭、请谁当法官，都由检察官决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看到有人違反家規的人當檢察官來提出。爸爸媽媽也可以當檢察官！要把誰送上法庭、請誰當法官，都由檢察官決定。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот, кто увидел нарушение домашнего правила, становится прокурором и подаёт дело. Прокурором могут быть и родители! Прокурор решает, кого отдать под суд и кто будет судьёй."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien ve a alguien incumplir una ley de casa se convierte en fiscal y presenta el caso. ¡Los padres también pueden ser fiscales! El fiscal decide a quién llevar a juicio y quién será el juez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer einen Bruch der Hausregeln gesehen hat, wird Staatsanwalt und reicht den Fall ein. Auch Eltern können Staatsanwalt sein! Der Staatsanwalt bestimmt, wer angeklagt wird und wer Richter ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui qui a vu quelqu’un enfreindre une loi de la maison devient procureur et dépose l’affaire. Les parents aussi peuvent être procureur ! Le procureur choisit qui sera jugé et qui sera juge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi vede qualcuno violare una legge di casa diventa pubblico ministero e presenta il caso. Anche i genitori possono fare il PM! Il PM decide chi mandare a processo e chi sarà il giudice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem viu alguém desrespeitar uma lei da casa vira promotor e abre o caso. Pai e mãe também podem ser promotores! O promotor escolhe quem vai a julgamento e quem será o juiz."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่เห็นคนทำผิดกฎบ้านจะเป็นอัยการและยื่นฟ้อง พ่อแม่ก็เป็นอัยการได้! อัยการเลือกว่าจะฟ้องใครและใครเป็นผู้พิพากษา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người thấy ai đó vi phạm luật nhà mình sẽ làm công tố viên và nộp đơn. Bố mẹ cũng có thể làm công tố viên! Đưa ai ra xét xử, ai làm thẩm phán đều do công tố viên chọn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo viděl porušení domácího pravidla, stane se státním zástupcem a podá případ. Státním zástupcem mohou být i rodiče! Státní zástupce vybere, kdo půjde před soud a kdo bude soudcem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der så en husregel blive brudt, bliver anklager og anlægger sagen. Forældre kan også være anklager! Anklageren bestemmer, hvem der skal for retten, og hvem der er dommer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος είδε να παραβιάζεται ένας νόμος του σπιτιού γίνεται εισαγγελέας και καταθέτει την υπόθεση. Και οι γονείς μπορούν να γίνουν εισαγγελείς! Ο εισαγγελέας ορίζει ποιος δικάζεται και ποιος είναι ο δικαστής."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, joka näki jonkun rikkovan kotisääntöä, ryhtyy syyttäjäksi ja jättää asian. Vanhemmatkin voivat olla syyttäjiä! Syyttäjä päättää, kuka viedään oikeuteen ja kuka on tuomari."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang melihat pelanggaran hukum rumah kita menjadi jaksa dan mengajukannya. Orang tua juga bisa jadi jaksa! Jaksa yang memilih siapa yang dibawa ke sidang dan siapa hakimnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som så noen bryte en husregel, blir aktor og leverer saken. Foreldre kan også være aktor! Aktor bestemmer hvem som stilles for retten, og hvem som er dommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie zag dat een huisregel werd overtreden, wordt aanklager en dient de zaak in. Ook ouders kunnen aanklager zijn! De aanklager kiest wie terecht moet staan en wie de rechter is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto zobaczył, że ktoś złamał domowe prawo, zostaje prokuratorem i składa sprawę. Prokuratorem mogą być też rodzice! Prokurator wybiera, kto stanie przed sądem i kto będzie sędzią."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som såg någon bryta mot en husregel blir åklagare och lämnar in målet. Föräldrar kan också vara åklagare! Åklagaren bestämmer vem som ställs inför rätta och vem som är domare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev kanunlarının çiğnendiğini gören kişi savcı olur ve davayı açar. Anne baba da savcı olabilir! Kimin yargılanacağını ve hakimin kim olacağını savcı seçer."
          }
        }
      }
    },
    "우리 집 법을 어긴 사람의 벌칙을 정하는 재판이에요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trial to decide a penalty for someone who broke a house rule."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trial to decide a penalty for someone who broke a house rule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わが家の法律をやぶった人の罰を決める裁判です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
