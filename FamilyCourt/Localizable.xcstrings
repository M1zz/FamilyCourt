    "벌칙은 짧고 지킬 수 있게! %@ 스스로 제안한 벌칙이 가장 잘 지켜져요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep penalties short and doable! The ones the %@ suggests for themselves are kept best."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep penalties short and doable! The ones the %@ suggests for themselves are kept best."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "罰は短く、守れるものに！ %@が自分で考えた罰が、いちばん守られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "惩罚要简短、做得到！%@自己提出的惩罚最容易做到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處罰要簡短、做得到！%@自己提出的處罰最容易做到。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наказание — короткое и выполнимое! Лучше всего соблюдается то наказание, которое предлагает сам %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Que la sanción sea corta y fácil de cumplir! La que propone quien va a juicio (%@) es la que mejor se cumple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strafen kurz und machbar halten! Am besten klappt eine Strafe, die man selbst vorschlägt (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sanction courte et facile à tenir ! Celle que la personne jugée (%@) propose elle-même est la mieux respectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sanzione deve essere breve e fattibile! Quella proposta da chi viene processato (%@) è la più rispettata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penas curtas e possíveis de cumprir! Funciona melhor quando a pena é sugerida pela própria pessoa (%@)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บทลงโทษควรสั้นและทำได้จริง! บทลงโทษที่%@เสนอเองมักทำได้ดีที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình phạt nên ngắn và làm được! Hình phạt do %@ tự đề xuất thường được giữ tốt nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trest ať je krátký a splnitelný! Nejlépe se plní trest, který navrhne sám %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold straffen kort og til at klare! En straf, man selv foreslår, bliver bedst overholdt (%@)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τιμωρία να είναι μικρή και εφικτή! Τηρείται καλύτερα όταν την προτείνει ο ίδιος (%@)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangaistuksen pitää olla lyhyt ja sellainen, että sen jaksaa hoitaa! Parhaiten pidetään rangaistus, jonka on itse ehdottanut (%@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukuman sebaiknya singkat dan bisa dijalankan! Hukuman yang diusulkan sendiri oleh %@ biasanya paling ditaati."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straffen skal være kort og mulig å klare! Best holdes en straff man har foreslått selv (%@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd straffen kort en haalbaar! Een straf die je zelf bedenkt, houd je het best vol (%@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kara ma być krótka i wykonalna! Najlepiej działa kara, którą zaproponuje sam %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straffet ska vara kort och gå att klara! Bäst hålls ett straff som man själv har föreslagit (%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cezalar kısa ve yapılabilir olsun! %@ kendi önerdiği cezayı en iyi şekilde yerine getirir."
          }
        }
      }
    },
