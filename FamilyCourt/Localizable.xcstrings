    "어린아이도 알 수 있는 쉬운 말로 보여줘요.\n예) 판사 → 심판, 원고 → 억울한 사람, 판결 → 결정" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy words even little kids understand.\ne.g. Judge → Referee, Plaintiff → Upset One, Verdict → Decision"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy words even little children understand.\ne.g. Judge → Referee, Plaintiff → Upset One, Verdict → Decision"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな子どもにもわかる、やさしいことばで表示します。\n例）裁判官 → しんぱん、原告 → くやしい思いをした人、判決 → きめたこと"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用小朋友也能听懂的简单说法。\n例）法官 → 小裁判，原告 → 觉得委屈的人，判决 → 决定"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用小朋友也聽得懂的簡單說法。\n例）法官 → 小裁判，原告 → 覺得委屈的人，判決 → 決定"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простые слова, понятные даже малышам.\nНапример: судья → рефери, истец → обиженный, приговор → решение"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palabras sencillas que entienden hasta los más pequeños.\nEj.: Juez → Árbitro, Demandante → Quien se queja, Sentencia → Decisión"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfache Wörter, die schon kleine Kinder verstehen.\nz. B. Richter → Schiri, Kläger → Wer sich beschwert, Urteil → Entscheidung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des mots simples que même les tout-petits comprennent.\nEx. : Juge → Arbitre, Demandeur → Celui qui se plaint, Verdict → Décision"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parole semplici che capiscono anche i più piccoli.\nEs.: Giudice → Arbitro, Attore → Chi ha subito un torto, Sentenza → Decisione"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palavras simples que até os pequenos entendem.\nEx.: Juiz → Árbitro, Autor → Quem reclama, Sentença → Decisão"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้คำง่าย ๆ ที่เด็กเล็กก็เข้าใจ\nเช่น ผู้พิพากษา → กรรมการ, โจทก์ → คนที่รู้สึกไม่ยุติธรรม, คำพิพากษา → การตัดสินใจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng từ dễ hiểu, bé nhỏ cũng biết.\nVD: Thẩm phán → Trọng tài, Nguyên đơn → Người bị oan, Bản án → Quyết định"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednoduchá slova, kterým rozumí i malé děti.\nNapř.: soudce → rozhodčí, žalobce → ukřivděný, rozsudek → rozhodnutí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkle ord, som selv små børn forstår.\nF.eks. dommer → bestemmer, sagsøger → den, der klager, dom → afgørelse"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λέξεις τόσο απλές που τις καταλαβαίνουν και τα μικρά παιδιά.\nπ.χ. Δικαστής → Διαιτητής, Ενάγων → Όποιος αδικήθηκε, Κατηγορούμενος → Όποιος απαντά"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helppoja sanoja, joita pienetkin lapset ymmärtävät.\nEsim. Tuomari → Erotuomari, Kantaja → Epäreilun kokenut, Tuomio → Päätös"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan dengan kata-kata mudah yang dipahami anak kecil.\nContoh) Hakim → Wasit, Penggugat → Yang Merasa Tak Adil, Putusan → Keputusan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkle ord som selv små barn forstår.\nF.eks. Dommeren → Bestemmeren, Saksøkeren → Den som synes det er urettferdig, Dom → Avgjørelse"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makkelijke woorden die zelfs kleine kinderen snappen.\nBijv. rechter → scheidsrechter, eiser → wie het oneerlijk vindt, vonnis → besluit"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proste słowa, które zrozumie nawet maluch.\nNp.: sędzia → rozjemca, powód → poszkodowany, wyrok → decyzja"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkla ord som även små barn förstår.\nT.ex. Domaren → Bestämmaren, Käranden → Den som tycker det är orättvist, Dom → Beslut"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük çocukların bile anlayacağı kolay kelimeler.\nÖrn. Hakim → Hakem, Davacı → Haksızlığa uğrayan, Hüküm → Karar"
          }
        }
      }
    },
