        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný případ nečeká na soud.\nDoma je klid a mír!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen sager venter på et retsmøde.\nDer er fred og ro derhjemme!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
