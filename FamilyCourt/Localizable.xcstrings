    "판결에서 정한 일을 잊지 않도록 알맞은 때에 알려 줘요." : {
      "comment" : "Roadmap item detail: notifications",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a timely reminder so no one forgets what the verdict decided."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "판결에서 정한 일을 잊지 않도록 알맞은 때에 알려 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a timely reminder so no one forgets what the verdict decided."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "判決で決めたことを忘れないよう、ちょうどよいタイミングでお知らせします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在合适的时间提醒，让大家不会忘记判决里定下的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在適當的時間提醒，讓大家不會忘記判決裡訂下的事。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вовремя напомним, чтобы никто не забыл, что решил приговор."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un recordatorio a tiempo para que nadie olvide lo que decidió el veredicto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte rechtzeitig eine Erinnerung, damit niemand vergisst, was das Urteil festgelegt hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez un rappel au bon moment pour que personne n’oublie ce que le verdict a décidé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un promemoria al momento giusto così nessuno dimentica cosa ha deciso il verdetto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um lembrete na hora certa para ninguém esquecer o que o veredito decidiu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับการเตือนในเวลาที่เหมาะสม จะได้ไม่มีใครลืมสิ่งที่คำตัดสินกำหนดไว้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận lời nhắc đúng lúc để không ai quên những gì phán quyết đã quyết định."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostanete připomenutí ve správný čas, aby nikdo nezapomněl, co rozsudek určil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en påmindelse på det rette tidspunkt, så ingen glemmer, hvad dommen bestemte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβετε υπενθύμιση την κατάλληλη στιγμή, ώστε κανείς να μη ξεχάσει τι όρισε η απόφαση."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat muistutuksen sopivaan aikaan, jotta kukaan ei unohda, mitä tuomio määräsi."
