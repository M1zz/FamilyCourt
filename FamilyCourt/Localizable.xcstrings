          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip for å endre en lov"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg om een regel te wijzigen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń prawo, by je zmienić"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep för att ändra en lag"
          }
