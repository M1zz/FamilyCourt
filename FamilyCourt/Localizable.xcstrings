        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que desordeno, lo ordeno yo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer Unordnung macht, räumt sie selbst wieder auf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que je dérange, je le range."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che metto in disordine, lo rimetto a posto io."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem bagunçou, arruma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครทำรกต้องเก็บเอง"
