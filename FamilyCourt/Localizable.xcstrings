    "역할은 재판을 신청한 사람이 이미 정했어요. 재판에 넘겨지는 사람은 자기를 도와줄 %@ 고를 수 있어요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person who asked for the trial has already chosen the roles. The person brought to trial can pick a %@ to help them!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person who asked for the trial has already chosen the roles. The person brought to trial can pick a %@ to help them!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "役わりは、裁判を申し立てた人がもう決めています。裁判にかけられた人は、自分を助けてくれる%@を選べます！"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角色已经由申请审判的人定好了。被带上法庭的人可以选一位帮自己的%@！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角色已經由申請審判的人決定好了。被帶上法庭的人可以選一位幫自己的%@！"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Роли уже распределил тот, кто подал дело. А тот, кого вызвали в суд, может сам выбрать, кто ему поможет (%@)!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los papeles ya los eligió quien pidió el juicio. Quien va a juicio puede elegir a alguien que le ayude (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rollen hat schon festgelegt, wer den Fall eingereicht hat. Wer vor Gericht steht, darf sich jetzt noch Hilfe aussuchen: %@!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rôles ont déjà été choisis par la personne qui a demandé le procès. La personne jugée peut choisir quelqu’un pour l’aider (%@) !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ruoli li ha già scelti chi ha chiesto il processo. Chi viene processato può scegliere qualcuno che lo aiuti (%@)!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os papéis já foram escolhidos por quem abriu o caso. Quem vai a julgamento pode escolher alguém para ser %@!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ขอเปิดศาลเลือกบทบาทไว้แล้ว ส่วนคนที่ถูกพาขึ้นศาลเลือก%@มาช่วยตัวเองได้!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai trò đã được người nộp đơn chọn sẵn. Người bị đưa ra xử có thể tự chọn %@ giúp mình!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role už rozdělil ten, kdo případ podal. A ten, kdo stojí před soudem, si může sám vybrat, kdo mu pomůže (%@)!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der anlagde sagen, har allerede valgt rollerne. Den, der skal for retten, må stadig vælge en hjælper: %@!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τους ρόλους τούς όρισε ήδη όποιος ζήτησε τη δίκη. Όποιος δικάζεται μπορεί να διαλέξει κάποιον να τον βοηθήσει (%@)!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roolit on jo valinnut se, joka haki oikeudenkäyntiä. Oikeuteen viety voi valita itselleen auttajan (%@)!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peran sudah ditentukan oleh yang mengajukan sidang. Yang dibawa ke sidang boleh memilih %@ untuk membantunya!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollene er allerede valgt av den som ba om rettssaken. Den som stilles for retten, kan velge noen som hjelper (%@)!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de zaak heeft ingediend, heeft de rollen al gekozen. Wie terecht moet staan, mag nog iemand kiezen die helpt: %@!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role wybrała już osoba, która złożyła sprawę. A ten, kto stanie przed sądem, może sam wybrać, kto mu pomoże (%@)!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollerna har redan valts av den som begärde rättegången. Den som ställs inför rätta får välja någon som hjälper till (%@)!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolleri davayı açan kişi zaten seçti. Yargılanan kişi kendine yardım edecek birini seçebilir (%@)!"
          }
        }
      }
    },
